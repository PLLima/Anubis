  m_Name: Bakenkhonsu
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Bakenkhonsu
  npcSprite: {fileID: 8165316572449679646, guid: c6ad9002a5010e8caba6392c8a3ba15c, type: 3}
  dialogueBubbles:
  - snippets:
    - I am Bakenkhonsu.
    - I commanded the Medjay patrols.
    - We guarded the Pharaoh's gold mines.
  - snippets:
    - My laws were unforgiving.
    - My brother stole a chisel.
    - I sent him to the quarries.
  - snippets:
    - I refused to retreat from a massive desert raid.
    - Orders strictly forbade losing any gold.
    - A spear took my throat.
