  m_Name: Bakenkhonsu
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Bakenkhonsu
  npcSprite: {fileID: 0}
  dialogueBubbles:
  - snippets:
    - I am Bakenkhonsu.
    - I commanded the Medjay patrols guarding the Pharaoh's gold mines.
  - snippets:
    - My laws were unforgiving. When my brother stole a chisel, I sent him to the quarries.
  - snippets:
    - I refused to retreat from a massive desert raid because orders strictly forbade losing any gold.
  - snippets:
    - A spear took my throat. I am completely inflexible and will throw away lives for a rule.
