  m_Name: Senenmut
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Senenmut
  npcSprite: {fileID: 0}
  dialogueBubbles:
  - snippets:
    - I am Senenmut.
    - I managed the irrigation canals.
    - A broken dam meant the entire village would starve.
  - snippets:
    - I had to think fast when floods rose.
    - I once saved the harvest by building a mud wall in the dark.
  - snippets:
    - I refused to let my workers secure a heavy sluice gate.
    - I insisted on doing it myself.
    - I slipped and drowned in the current.
