  m_Name: Nefru
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Nefru
  npcSprite: {fileID: 0}
  dialogueBubbles:
  - snippets:
    - My name was Nefru.
    - During the flood season, we paid taxes with labor.
    - We hauled stones for the temples.
  - snippets:
    - I was incredibly strong.
    - I hated delays.
    - Give me a task, and I just want it done.
  - snippets:
    - I ordered my crew to use frayed lifting ropes.
    - I wanted to finish early.
    - A pillar fell and crushed my chest.
