  m_Script: {fileID: 11500000, guid: 67bdf615a298a9ca6a32537659c825b8, type: 3}
  m_Name: Nefer
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Nefer
  npcSprite: {fileID: 8165316572449679646, guid: c6ad9002a5010e8caba6392c8a3ba15c, type: 3}
  dialogueBubbles:
  - snippets:
    - In life, I was the greatest beauty of Egypt.
    - Men would fall over when they saw me.
  - snippets:
    - I had a wealthy husband.
    - I organized fancy parties and galas for all!
    - I was so renowned while I was alive!
  - snippets:
    - Alas, I became too self-absorbed.
    - A jealous man stabbed me in my sleep.
  - snippets:
    - I still believe that I am the most beautiful in death!
    - But the parties in the afterlife aren't as fun!
    - I miss having feasts every day.
  voiceProfile:
    audioClips: []
