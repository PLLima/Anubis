  m_Script: {fileID: 11500000, guid: 67bdf615a298a9ca6a32537659c825b8, type: 3}
  m_Name: Khepri
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Khepri
  npcSprite: {fileID: 8165316572449679646, guid: c6ad9002a5010e8caba6392c8a3ba15c, type: 3}
  dialogueBubbles:
  - snippets:
    - My name was Khepri.
    - I sailed from Memphis, trading linen for copper in a society without coins.
  - snippets:
    - I was a master of words, convincing people that common lapis amulets were blessed by Ptah.
  - snippets:
    - But a rival merchant grew tired of my lies and poisoned my beer during a festival.
  - snippets:
    - I swindled the wrong man. I make bitter enemies because I always prioritize my own profit over ethics.
