  m_Name: Ahmose
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Ahmose
  npcSprite: {fileID: -2256948484998397059, guid: 75acfd848ff0e7816aa2a2b5f8732369, type: 3}
  dialogueBubbles:
  - snippets:
    - Call me Ahmose.
    - I lived in the workers' village.
    - I carved royal tombs in the Valley of the Kings.
  - snippets:
    - Unofficially, I knew exactly how to bypass the false doors.
    - I stole many lapis amulets.
  - snippets:
    - I bragged about my thefts to a friend.
    - He betrayed me for a reward.
    - The guards impaled me.
