  npcName: Tut
  npcSprite: {fileID: 6542371343288760746, guid: 8c173654e73a549d59a55c8f7a8c132c, type: 3}
  dialogueBubbles:
  - snippets:
    - I am Tut from Amun!
    - A lowly peasant who worked in the fields.
  - snippets:
    - 'Everyday I spent harvesting wheat, barley and flax. '
    - I couldn't help that I flunked out of scribe school.
    - I guess I was happy with a simple life.
  - snippets:
    - I was a pretty good swimmer!
    - While I was swimming, a hippo grabbed me.
    - I became the hippo's next meal!
  - snippets:
    - I was scatterbrained in life.
    - Working long hours was how I spent my days.
    - I died of carelessness!
  voiceProfile:
    audioClips: []
    basePitch: 1.215
    pitchVariation: 0.0355
    charFrequency: 0
    customInterval: 0
