  m_Name: Menna
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: Menna
  npcSprite: {fileID: 0}
  dialogueBubbles:
  - snippets:
    - I am Menna.
    - I led trade caravans beyond the southern borders.
    - I brought back gold and myrrh.
  - snippets:
    - I spoke the tongues of Nubian kings.
    - The one who controls the language controls the deal.
  - snippets:
    - To save time, I ignored local guides.
    - I marched my caravan directly into a massive sandstorm.
    - We were buried alive.
